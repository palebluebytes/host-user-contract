# ben — a plain cli reference user, and the MINIMAL declaration this contract accepts.
#
# One line. He is a terminal user, so `cli` is the whole of it — and because nothing defaults to
# true, saying nothing would make him uninstallable rather than quietly cli.
#
# Useful as a co-resident account on a host that also binds a privileged user, and as a second
# borrowable atom for the conformance suite.
{
  contract.cli.enable = true;
}
